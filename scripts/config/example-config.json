{
  "InstallMode": "SingleInstance",
  "Connection": {
    "ServerInstance": "SQL-PRD-01",
    "AuthMethod": "Windows",
    "Database": "DBA_Monitor"
  },
  "Collectors": {
    "EnableAll": true,
    "Disabled": [],
    "TopQueriesCount": 25,
    "IndexFragmentationThreshold": 30,
    "ErrorLogHoursBack": 24
  },
  "Alerts": {
    "Enabled": true,
    "UseDefaults": true,
    "Recipients": ["dba@company.com"],
    "CustomThresholds": {
      "CPU_Warning": 80,
      "CPU_Critical": 95,
      "Memory_Warning": 85,
      "Memory_Critical": 95,
      "Disk_Warning": 85,
      "Disk_Critical": 95,
      "PLE_Warning": 300,
      "PLE_Critical": 100,
      "Blocking_Seconds": 30,
      "Deadlock_Count": 1,
      "AG_Lag_Minutes": 30,
      "Backup_Hours_Old": 24,
      "Job_Failure_Count": 1,
      "ErrorLog_Count": 10
    }
  },
  "Reports": {
    "DailyEnabled": true,
    "WeeklyEnabled": true,
    "Recipients": ["dba@company.com", "manager@company.com"],
    "Language": "EN",
    "DailyTime": "07:00",
    "WeeklyDay": "Monday",
    "WeeklyTime": "08:00"
  },
  "Email": {
    "Method": "DatabaseMail",
    "ProfileName": "DBA Mail",
    "SMTP": {
      "Server": "smtp.company.com",
      "Port": 587,
      "UseSSL": true,
      "Username": "sqlmonitor@company.com",
      "Password": "encrypted_password"
    },
    "From": "sqlhealthmonitor@company.com",
    "SubjectPrefix": "[SQL Health]",
    "Recipients": {
      "Daily": ["dba@company.com"],
      "Weekly": ["dba@company.com", "it-management@company.com"],
      "Alert": ["dba@company.com", "oncall@company.com"]
    }
  },
  "Scheduling": {
    "CreateAgentJobs": true,
    "CollectionInterval": "15min",
    "AlertInterval": "5min",
    "DailyReportTime": "07:00",
    "WeeklyReportDay": "Monday",
    "WeeklyReportTime": "08:00"
  },
  "Baselines": {
    "Enabled": true,
    "CaptureNow": false,
    "LookbackDays": 7,
    "WarningMultiplier": 2.0,
    "CriticalMultiplier": 3.0
  },
  "Retention": {
    "UseDefaults": true,
    "RawDataDays": 30,
    "DailySummaryDays": 90,
    "WeeklySummaryDays": 365,
    "AlertHistoryDays": 365,
    "AnomalyDays": 90,
    "ReportHistoryDays": 180
  },
  "Logging": {
    "Path": "C:\\SQLHealthMonitor\\Logs",
    "RetentionDays": 30,
    "Level": "Information"
  },
  "ConfigProfile": "PRODUCTION"
}